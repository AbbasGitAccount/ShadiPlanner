# Android emulator: http://10.0.2.2:5000/api
# Physical Android: http://YOUR_PC_LAN_IP:5000/api (phone and PC on the same Wi-Fi)
# Development automatically tries the Metro host on port 5000 when this is unset.
# Release / preview APKs require your deployed HTTPS backend.
EXPO_PUBLIC_API_URL=http://10.0.2.2:5000/api
# EXPO_PUBLIC variables are bundled into the app. Never put JWT, database or payment secrets here.
