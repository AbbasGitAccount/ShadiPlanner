# ==============================================================================
# DATABASE CONFIGURATION
# ==============================================================================
# IMPORTANT: Replace this placeholder with your real PostgreSQL connection URL!
# Do NOT leave 'HOST' or 'USERNAME:PASSWORD' unchanged in production/Vercel.
# Examples:
#   Neon:     postgresql://user:pass@ep-xyz-123.us-east-2.aws.neon.tech:5432/neondb?sslmode=require&uselibpqcompat=true
#   Supabase: postgresql://postgres:pass@db.xyz.supabase.co:5432/postgres?sslmode=require&uselibpqcompat=true
#   Local:    postgresql://postgres:postgres@localhost:5432/shadiplanner
DATABASE_URL=postgresql://USERNAME:PASSWORD@HOST:5432/DATABASE?sslmode=require&uselibpqcompat=true

# Secret key used for signing JWT authentication tokens
JWT_SECRET=replace-this-with-a-long-random-secret

# Server Port
PORT=5000

# Redis Cache URL (optional; profile reads fall back to PostgreSQL if Redis is not running)
REDIS_URL=redis://127.0.0.1:6379

PHONE_VERIFICATION_MODE=test
# Test mode sends no SMS and never marks a phone as verified. Disabled when NODE_ENV=production.

# Initial subscription catalogue (used only when a plan does not exist).
# Subsequent edits are persisted through Admin > Subscriptions with audit history.
# Amounts are integer paise; no billing period is assumed.
GOLD_PRICE_PAISE=99900
PLATINUM_PRICE_PAISE=199900
# Set only after the billing duration has been confirmed (positive whole days).
SUBSCRIPTION_DURATION_DAYS=20
FREE_PROFILE_LIMIT=20
